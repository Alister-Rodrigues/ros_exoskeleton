<?xml version="1.0"?>
<robot name="robot_arm">
    <material name="yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0"/>
    </material>

    <link name="base_footprint">
    </link>
    <link name="arm_base_link">
        <inertial>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <mass value="0.5"/>
            <inertia ixx="0.000433" ixy="0.0" ixz="0.0" iyy="0.000433" iyz="0.0" izz="0.000833"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
            <material name="orange">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
        </collision>
    </link>
    <link name="forearm_link">
        <inertial>
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <mass value="0.3"/>
            <inertia ixx="0.00228" ixy="0.0" ixz="0.0" iyy="0.00228" iyz="0.0" izz="0.00006"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <material name="yellow">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
        </collision>
    </link>
    <link name="hand_link">
        <inertial>
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <mass value="0.3"/>
            <inertia ixx="0.00228" ixy="0.0" ixz="0.0" iyy="0.00228" iyz="0.0" izz="0.00006"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
            <material name="yellow">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.02" length="0.3"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_footprint"/>
        <child link="arm_base_link"/>
    </joint>
    <joint name="arm_base_forearm_joint" type="revolute">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="arm_base_link"/>
        <child link="forearm_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0.0" upper="1.57" effort="100.0" velocity="100.0"/>
        <dynamics friction="0.3" damping="0.3" /> 
    </joint>
    <joint name="forearm_hand_joint" type="revolute">
        <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
        <parent link="forearm_link"/>
        <child link="hand_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0.0" upper="1.5708" effort="100.0" velocity="100.0"/>
        <dynamics friction="0.3" damping="0.3" /> 
    </joint>
    <gazebo>
        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
            <topic>/model/arm/ali_rob_arm_joint_state</topic>
            <joint_name>
                arm_base_forearm_joint
            </joint_name>
            <joint_name>
                forearm_hand_joint
            </joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>arm_base_forearm_joint</joint_name>
            <p_gain>5.0</p_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>forearm_hand_joint</joint_name>
            <p_gain>5.0</p_gain>
        </plugin>
    </gazebo>
</robot>