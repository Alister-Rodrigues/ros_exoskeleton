<?xml version="1.0"?>
<robot name="practice_arm">
    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
        </collision>
    </link>
    <!-- joint 1 -->
    <link name="shoulder_link">
        <visual>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.1" length="0.5"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 0.2 0.5"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_shoulder_joint" type="revolute">
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="shoulder_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    </joint>

    <!-- joint 2 -->
    <link name="arm_link">
        <visual>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.6"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.6"/>
            </geometry>
        </collision>
    </link>
    <joint name="shoulder_arm_joint" type="revolute">
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
        <parent link="shoulder_link"/>
        <child link="arm_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0" upper="2.5" effort="100.0" velocity="100.0"/>
    </joint>

    <!-- joint 3 -->
    <link name="elbow_link">
        <visual>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.1"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.1"/>
            </geometry>
        </collision>
    </link>
    <joint name="arm_elbow_joint" type="revolute">
        <origin xyz="0.0 0.0 0.6" rpy="0.0 0.0 0.0"/>
        <parent link="arm_link"/>
        <child link="elbow_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="0.0" upper="2.5" effort="100.0" velocity="100.0"/>
    </joint>
    
    <!-- joint 4-->
    <link name="forearm_link">
        <visual>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.05" length="0.5"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.5"/>
            </geometry>
        </collision>
    </link>
    <joint name="elbow_forearm_joint" type="revolute">
        <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
        <parent link="elbow_link"/>
        <child link="forearm_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.14" upper="3.14" effort="100.0" velocity="100.0"/>
    </joint>
    
    <!-- joint 5 -->
    <link name="wrist_link">
        <visual>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="forearm_wrist_joint" type="revolute">
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
        <parent link="forearm_link"/>
        <child link="wrist_link"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    </joint>
    
    <!-- joint 6 -->
    <link name="hand_link">
        <visual>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.1 0.1 0.02"/>
            </geometry>
        </collision>
    </link>
    <joint name="wrist_hand_joint" type="continuous">
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <parent link="wrist_link"/>
        <child link="hand_link"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.57" upper="1.57" effort="100.0" velocity="100.0"/>
    </joint>
    <link name="tool_link"></link>
    <joint name="hand_tool_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="hand_link"/>
        <child link="tool_link"/>
    </joint>

    <link name="gripper_base_link">
        <visual name="">
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.12 0.04 0.02"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.12 0.04 0.02"/>
            </geometry>
        </collision>
    </link>
    <joint name="tool_gripper_mount_joint" type="fixed">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="tool_link"/>
        <child link="gripper_base_link"/>
    </joint>

    <link name="left_finger_link">
        <visual name="">
            <origin xyz="0.01 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="0.01 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
        </collision>
    </link>
    <joint name="gripper_left_finger_joint" type="prismatic">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="gripper_base_link"/>
        <child link="left_finger_link"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="0.0" upper="0.04" effort="100.0" velocity="100.0"/>
    </joint>

    <link name="right_finger_link">
        <visual name="">
            <origin xyz="-0.01 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
            <material name="black">
            </material>
        </visual>
        <collision>
            <origin xyz="-0.01 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.02 0.02 0.08"/>
            </geometry>
        </collision>
    </link>
    <joint name="gripper_right_finger_joint" type="prismatic">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <parent link="gripper_base_link"/>
        <child link="right_finger_link"/>
        <axis xyz="1.0 0.0 0.0"/>
        <limit lower="-0.04" upper="0.0" effort="100.0" velocity="100.0"/>
        <mimic joint="gripper_left_finger_joint" multiplier="-1.0" offset="0.0"/>
    </joint>

    <link name="left_pad_link">
        <visual name="">
            <origin xyz="0.005 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="0.005 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
        </collision>
    </link>
    <joint name="left_finger_pad_joint" type="fixed">
        <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
        <parent link="left_finger_link"/>
        <child link="left_pad_link"/>
    </joint>

    <link name="right_pad_link">
        <visual name="">
            <origin xyz="-0.005 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
            <material name="white">
            </material>
        </visual>
        <collision>
            <origin xyz="-0.005 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.01 0.03 0.02"/>
            </geometry>
        </collision>
    </link>
    <joint name="right_finger_pad_joint" type="fixed">
        <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
        <parent link="right_finger_link"/>
        <child link="right_pad_link"/>
    </joint>

    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>base_shoulder_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>shoulder_arm_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>arm_elbow_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>elbow_forearm_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>forearm_wrist_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>wrist_hand_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>base_shoulder_joint_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>1.0</p_gain>
            <i_gain>0.1</i_gain>
            <d_gain>0.05</d_gain>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin name="gz::sim::systems::JointController" filename="gz-sim-joint-controller-system">
            <joint_name>gripper_left_finger_joint</joint_name>
            <use_force>false</use_force>
            <p_gain>0.5</p_gain>
            <i_gain>0.05</i_gain>
            <d_gain>0.01</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
            <topic>/model/arm/ali_arm_joint_state</topic>
            <joint_name>
                base_shoulder_joint, 
                shoulder_arm_joint, 
                arm_elbow_joint, 
                elbow_forearm_joint, 
                forearm_wrist_joint, 
                wrist_hand_joint, 
                gripper_left_finger_joint, 
                gripper_right_finger_joint
            </joint_name>
        </plugin>
    </gazebo>
</robot>

